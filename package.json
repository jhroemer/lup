{
  "name": "lup-reporter",
  "version": "0.0.0-dev",
  "description": "A Playwright reporter for smooth screenshot reviews.",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "reporter",
    "screenshot",
    "test",
    "visual-regression"
  ],
  "license": "MIT",
  "author": "Jens Rømer Hesselbjerg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhroemer/lup-reporter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": "./dist/reporter/reporter.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate-fixture-report": "npm run build && node scripts/generate-fixture-report.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "preact": "^11.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40"
  },
  "engines": {
    "node": ">=22"
  }
}
