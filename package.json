{
  "name": "playwright-screenshot-reporter",
  "version": "0.0.1",
  "private": true,
  "description": "A Playwright reporter for smooth screenshot reviews.",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "reporter",
    "screenshot",
    "test",
    "visual-regression"
  ],
  "license": "MIT",
  "author": "Jens Rømer Hesselbjerg",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate-fixture-report": "npm run build && node scripts/generate-fixture-report.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40"
  }
}
